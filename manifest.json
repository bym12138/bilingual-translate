{
  "manifest_version": 3,
  "name": "双语翻译",
  "version": "0.1.0",
  "description": "网页双语对照翻译 + YouTube 双语字幕",
  "icons": { "16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png", "128": "icons/off-128.png" },
  "action": {
    "default_title": "翻译 / 还原此页面 (⌥A)",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://translate-pa.googleapis.com/*"],
  "commands": {
    "toggle-page": {
      "suggested_key": { "mac": "Alt+A" },
      "description": "翻译 / 还原此页面"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_start"
    }
  ]
}
